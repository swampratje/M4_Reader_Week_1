Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"f", "[", "x_", "]"}], "=", 
  RowBox[{"x", "+", 
   RowBox[{"1000", " ", 
    SuperscriptBox["x", "2"]}]}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"T1", "[", "x_", "]"}], "=", "x"}], "\[IndentingNewLine]", 
 RowBox[{"Plot", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"f", "[", "x", "]"}], ",", 
     RowBox[{"T1", "[", "x", "]"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"x", ",", 
     RowBox[{"-", "0.01"}], ",", "0.01"}], "}"}], ",", 
   RowBox[{"AspectRatio", "->", 
    RowBox[{"3", "/", "4"}]}], ",", 
   RowBox[{"AxesLabel", "->", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"MaTeX", "[", 
       RowBox[{"\"\<\\\\,\\\\,x\>\"", ",", 
        RowBox[{"Magnification", "->", "1.5"}]}], "]"}], ",", 
