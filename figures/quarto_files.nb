Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"nmax", "=", "50"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"vals", "=", 
    RowBox[{"Transpose", "@", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Range", "[", "nmax", "]"}], ",", 
       RowBox[{"Accumulate", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{"-", "1"}], ")"}], "^", 
          RowBox[{"Range", "[", "nmax", "]"}]}], "/", 
         RowBox[{"Range", "[", "nmax", "]"}]}], "]"}]}], "}"}]}]}], ";"}], 
  "\n", "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"llp", "=", 
   RowBox[{"ListLinePlot", "[", 
    RowBox[{"vals", ",", 
     RowBox[{"PlotRange", "->", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"-", "1"}], ",", 
        RowBox[{"-", "0.4"}]}], "}"}]}], ",", 
     RowBox[{"Frame", "->", "True"}], ",", 
     RowBox[{"FrameLabel", "->", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"MaTeX", "[", 
         RowBox[{"\"\<n\>\"", ",", 
          RowBox[{"Magnification", "->", "1.6"}]}], "]"}], ",", 
        RowBox[{"MaTeX", "[", 
         RowBox[{"\"\<s_n\>\"", ",", 
          RowBox[{"Magnification", "->", "1.6"}]}], "]"}]}], "}"}]}], ",", 
     RowBox[{"PlotTheme", "->", "\"\<Scientific\>\""}], ",", 
     RowBox[{"PlotStyle", "->", 
      RowBox[{"{", 
       RowBox[{"Red", ",", "Dashed"}], "}"}]}], ",", 
     RowBox[{"ImageSize", "->", "Large"}], ",", 
     RowBox[{"Epilog", "->", 
      RowBox[{"{", 
       RowBox[{"(*", 
        RowBox[{"points", " ", "at", " ", "partial", " ", "sums"}], "*)"}], 
       RowBox[{"Black", ",", 
        RowBox[{"PointSize", "[", "0.006", "]"}], ",", 
        RowBox[{"Point", "[", "vals", "]"}], ",", 
        RowBox[{"(*", 
         RowBox[{
          RowBox[{"limit", " ", "line"}], "+", "labels"}], "*)"}], "Blue", 
        ",", "Thick", ",", 
        RowBox[{"Line", "[", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"1", ",", 
             RowBox[{"-", 
              RowBox[{"Log", "[", "2", "]"}]}]}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"nmax", ",", 
             RowBox[{"-", 
              RowBox[{"Log", "[", "2", "]"}]}]}], "}"}]}], "}"}], "]"}], ",", 
        
        RowBox[{"Inset", "[", 
         RowBox[{
          RowBox[{"MaTeX", "[", 
           RowBox[{"\"\<\\\\color{blue} -\\\\ln(2)\>\"", ",", 
            RowBox[{"Magnification", "->", "1.6"}]}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"0.85", " ", "nmax"}], ",", 
            RowBox[{"0.05", "-", 
             RowBox[{"Log", "[", "2", "]"}]}]}], "}"}]}], "]"}], ",", 
        RowBox[{"Inset", "[", 
         RowBox[{
          RowBox[{"MaTeX", "[", 
           RowBox[{"\"\<s_n=\\\\sum_{k=1}^n(-1)^k\\\\frac{1}{{k}}\>\"", ",", 
            RowBox[{"Magnification", "->", "1.6"}]}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"0.5", " ", "nmax"}], ",", 
            RowBox[{
             RowBox[{"-", "0.1"}], "-", 
             RowBox[{"Log", "[", "2", "]"}]}]}], "}"}]}], "]"}]}], "}"}]}]}], 
    "]"}]}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Export", "[", 
   RowBox[{"\"\<alternating_series.png\>\"", ",", "llp", ",", 
    RowBox[{"ImageResolution", "->", "600"}]}], "]"}], "\n"}], "\n"}], "Input",\

