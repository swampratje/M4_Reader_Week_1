Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"Needs", "[", "\"\<MaTeX`\>\"", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"SetOptions", "[", 
    RowBox[{"MaTeX", ",", 
     RowBox[{"FontSize", "->", "14"}]}], "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"f", "[", "x_", "]"}], "=", 
   RowBox[{"2", "-", 
    RowBox[{"Exp", "[", 
     RowBox[{"x", "-", "1"}], "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"g0", "[", "x_", "]"}], "=", "1"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"g1", "[", "x_", "]"}], "=", 
    RowBox[{"2", "-", "x"}]}], ";"}], "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"labs", "=", 
    RowBox[{"MaTeX", "/@", 
     RowBox[{"{", 
      RowBox[{
      "\"\<f(x)=2-e^{x-1}\>\"", ",", "\"\<g_0(x)=1\>\"", ",", 
       "\"\<g_1(x)=2-x\>\""}], "}"}]}]}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{"Plot", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"f", "[", "x", "]"}], ",", 
     RowBox[{"g0", "[", "x", "]"}], ",", 
     RowBox[{"g1", "[", "x", "]"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"x", ",", "0", ",", "2"}], "}"}], ",", 
   RowBox[{"PlotStyle", "->", 
    RowBox[{"{", 
     RowBox[{"Red", ",", "Automatic", ",", "Automatic"}], "}"}]}], ",", 
   RowBox[{"AxesLabel", "->", 
    RowBox[{"MaTeX", "/@", 
     RowBox[{"{", 
      RowBox[{"\"\<x\>\"", ",", "\"\<y\>\""}], "}"}]}]}], ",", 
   RowBox[{"PlotLegends", "->", 
    RowBox[{"Placed", "[", 
     RowBox[{
      RowBox[{"LineLegend", "[", "labs", "]"}], ",", "After"}], "]"}]}], ",", 
   
   RowBox[{"ImageMargins", "->", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"10", ",", "60"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"10", ",", "10"}], "}"}]}], "}"}]}]}], "  ", 
