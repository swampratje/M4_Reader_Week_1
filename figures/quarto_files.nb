Cell[BoxData[{
 RowBox[{
  RowBox[{"f", "[", "x_", "]"}], "=", 
  RowBox[{"Exp", "[", "x", "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"g", "[", 
   RowBox[{"x_", ",", "a_"}], "]"}], "=", 
  RowBox[{
   RowBox[{"f", "[", "a", "]"}], "+", 
   RowBox[{
    RowBox[{
     RowBox[{"f", "'"}], "[", "a", "]"}], 
    RowBox[{"(", 
     RowBox[{"x", "-", "a"}], ")"}]}]}]}], "\[IndentingNewLine]", 
